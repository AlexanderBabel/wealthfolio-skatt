{
  "id": "wealthfolio-addon-skatt",
  "name": "Skatt (Sweden)",
  "version": "0.1.0",
  "description": "Swedish capital income tax per calendar year for ISK and depå accounts",
  "author": "Alex Babel",
  "main": "dist/addon.js",
  "sdkVersion": "3.6.2",
  "minWealthfolioVersion": "3.6.2",
  "enabled": true,
  "contributes": {
    "routes": [
      {
        "id": "wealthfolio-addon-skatt"
      }
    ],
    "links": {
      "sidebar": [
        {
          "id": "wealthfolio-addon-skatt",
          "route": "wealthfolio-addon-skatt",
          "label": "Skatt",
          "icon": "scales",
          "order": 100
        }
      ]
    }
  },
  "hostDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@wealthfolio/addon-sdk": "^3.6.2",
    "@wealthfolio/ui": "^3.6.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0"
  },
  "permissions": [
    {
      "category": "accounts",
      "functions": [
        {
          "name": "getAll",
          "isDeclared": true,
          "isDetected": false
        }
      ],
      "purpose": "List accounts so each one can be classified as ISK, depå or untaxed."
    },
    {
      "category": "portfolio",
      "functions": [
        {
          "name": "getHistoricalValuations",
          "isDeclared": true,
          "isDetected": false
        }
      ],
      "purpose": "Read the account value at each quarter start, which is what the ISK kapitalunderlag is built from."
    },
    {
      "category": "activities",
      "functions": [
        {
          "name": "getAll",
          "isDeclared": true,
          "isDetected": false
        }
      ],
      "purpose": "Read deposits, trades, dividends and interest to compute the taxable amounts."
    },
    {
      "category": "currency",
      "functions": [
        {
          "name": "getAll",
          "isDeclared": true,
          "isDetected": false
        }
      ],
      "purpose": "Convert amounts in a currency the account itself does not use into SEK."
    },
    {
      "category": "quotes",
      "functions": [
        {
          "name": "getHistory",
          "isDeclared": true,
          "isDetected": false
        }
      ],
      "purpose": "Read the daily exchange-rate history so a trade is converted at the rate on its own date."
    }
  ],
  "keywords": [
    "wealthfolio",
    "addon",
    "tax",
    "sweden",
    "isk",
    "skatt"
  ],
  "license": "MIT"
}
