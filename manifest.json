{
  "id": "wealthfolio-skatt",
  "name": "Skatt (Sweden)",
  "version": "1.0.0",
  "description": "Swedish capital income tax per calendar year for ISK, depå and crypto accounts",
  "author": "Alex Babel",
  "main": "dist/addon.js",
  "sdkVersion": "3.6.2",
  "minWealthfolioVersion": "3.6.2",
  "enabled": true,
  "contributes": {
    "routes": [
      {
        "id": "wealthfolio-skatt"
      }
    ],
    "links": {
      "sidebar": [
        {
          "id": "wealthfolio-skatt",
          "route": "wealthfolio-skatt",
          "label": "Skatt",
          "icon": "scales",
          "order": 100
        }
      ]
    }
  },
  "hostDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@wealthfolio/addon-sdk": "^3.6.2",
    "@wealthfolio/ui": "^3.6.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0"
  },
  "permissions": [
    {
      "category": "accounts",
      "functions": [
        {
          "name": "getAll",
          "isDeclared": true,
          "isDetected": false
        }
      ],
      "purpose": "List accounts so each one can be classified as ISK, depå or untaxed."
    },
    {
      "category": "portfolio",
      "functions": [
        {
          "name": "getHistoricalValuations",
          "isDeclared": true,
          "isDetected": false
        },
        {
          "name": "getHoldings",
          "isDeclared": true,
          "isDetected": false
        }
      ],
      "purpose": "Read the account value at each quarter start for the ISK kapitalunderlag, and current depå holdings to tell fund/ETF units apart from individual shares."
    },
    {
      "category": "activities",
      "functions": [
        {
          "name": "getAll",
          "isDeclared": true,
          "isDetected": false
        }
      ],
      "purpose": "Read deposits, trades, dividends and interest to compute the taxable amounts."
    },
    {
      "category": "currency",
      "functions": [
        {
          "name": "getAll",
          "isDeclared": true,
          "isDetected": false
        }
      ],
      "purpose": "Convert amounts in a currency the account itself does not use into SEK."
    },
    {
      "category": "quotes",
      "functions": [
        {
          "name": "getHistory",
          "isDeclared": true,
          "isDetected": false
        }
      ],
      "purpose": "Read the daily exchange-rate history so a trade is converted at the rate on its own date, and each depå holding's own price history for the fund schablonintäkt."
    },
    {
      "category": "assets",
      "functions": [
        {
          "name": "getProfile",
          "isDeclared": true,
          "isDetected": false
        }
      ],
      "purpose": "Tell fund and ETF holdings in a depå apart from individual shares, since only funds carry the 0.4 % schablonintäkt."
    },
    {
      "category": "events",
      "functions": [
        {
          "name": "onUpdateComplete",
          "isDeclared": true,
          "isDetected": false
        }
      ],
      "purpose": "Know when a trade, edit or import changes the portfolio, so the cached figures refresh then instead of on a timer."
    },
    {
      "category": "files",
      "functions": [
        {
          "name": "openSaveDialog",
          "isDeclared": true,
          "isDetected": false
        }
      ],
      "purpose": "Save the K4 avsnitt A export as a CSV file where you choose."
    }
  ],
  "keywords": [
    "wealthfolio",
    "addon",
    "tax",
    "sweden",
    "isk",
    "depa",
    "skatt",
    "krypto",
    "k4",
    "sru"
  ],
  "license": "MIT"
}
